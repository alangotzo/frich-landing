---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/delivery.css";

import cartelImage from "../assets/cartel.jpg";
import rappiLogo from "../assets/rappi.png";
import pedidosyaLogo from "../assets/pedidosya.png";
---

<Layout title="Delivery & App | Frich">
  <Header />

  <main class="delivery-page" style={`background-image: url('${cartelImage.src}')`}>
    <div class="delivery-overlay"></div>

    <div class="delivery-container delivery-content">
      <section class="delivery-hero">
        <h1>Pedí como quieras</h1>
        <p class="subtitle">Disfrutá de Frich directamente en tu casa a través de nuestra App o plataformas preferidas.</p>
      </section>

      <!-- Bloque 1: Nuestra App Oficial -->
      <section class="app-section">
        <div class="app-badge-tag">RECOMENDADO</div>
        <h2>Descargá nuestra App Oficial</h2>
        <p>Aprovechá descuentos exclusivos, sumá puntos con cada compra y acumulá beneficios para tus próximos pedidos.</p>

        <div class="store-buttons">
          <!-- Botón App Store -->
          <a href="https://apps.apple.com/ar/app/frich/id6499274163" target="_blank" rel="noopener noreferrer" class="store-btn" aria-label="Consíguelo en App Store">
            <svg class="store-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.32c.63-.77 1.06-1.84.94-2.92-.91.04-2.03.61-2.69 1.38-.58.68-1.09 1.77-.95 2.83 1.02.08 2.07-.52 2.7-1.29z"/>
            </svg>
            <div class="btn-text">
              <span class="subtext">Download on the</span>
              <span class="maintext">App Store</span>
            </div>
          </a>

          <!-- Botón Google Play -->
          <a href="https://play.google.com/store/apps/details?id=com.frichsfries.app&pcampaignid=web_share&pli=1" target="_blank" rel="noopener noreferrer" class="store-btn" aria-label="Consíguelo en Google Play">
            <svg class="store-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3 20.5v-17c0-.55.33-.94.8-.73l12.42 8.78c.42.24.42.82 0 1.06L3.8 21.23c-.47.21-.8-.18-.8-.73zm13.79-8.5L14 9.17l-2.6 2.63 2.6 2.63 2.79-2.43zm2.14-1.37l2.27 1.32c.45.26.45.92 0 1.18l-2.27 1.32-2.3-2.3 2.3-2.52z"/>
            </svg>
            <div class="btn-text">
              <span class="subtext">GET IT ON</span>
              <span class="maintext">Google Play</span>
            </div>
          </a>
        </div>
      </section>

      <!-- Bloque 2: Apps de Delivery Externas -->
      <section class="external-delivery-section">
        <h2>O pedí por tu plataforma favorita</h2>
        <p>También podés encontrarnos en las principales aplicaciones de delivery.</p>

        <div class="platforms-grid">
          <a href="https://www.rappi.com.ar/restaurantes/132532-frich-hamburgueseria" target="_blank" rel="noopener noreferrer" class="platform-card rappi-card">
            <div class="logo-wrapper">
              <img src={rappiLogo.src} alt="Rappi" />
            </div>
            <span>Pedir en Rappi</span>
          </a>

          <a href="https://www.pedidosya.com.ar/restaurantes/cordoba/frich-valle-escondido-5be706d2-e03b-418b-b9b2-d0443ad9b971-menu" target="_blank" rel="noopener noreferrer" class="platform-card pedidosya-card">
            <div class="logo-wrapper">
              <img src={pedidosyaLogo.src} alt="PedidosYa" />
            </div>
            <span>Pedir en PedidosYa</span>
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>