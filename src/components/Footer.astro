---
import "../styles/Footer.css";
const base = import.meta.env.BASE_URL;
// Enlaces organizados por categorías para estructurar mejor el footer
const footerLinks = {
  general: [
    { name: "Menú", href: "https://drive.google.com/drive/u/0/folders/13phvibzb3c1ECugDGOKeXQEQ2UYQI1Ax" },
    { name: "Nosotros", href: `${base}/nosotros/` },
    { name: "Ayuda", href: `${base}/ayuda/` },
    { name: "Linktree", href: "https://linktr.ee/frich.americantaste" },
    { name: "Trabaja con nosotros", href: `${base}/trabaja/` },
  ],
  locales: [
    { name: "Contacto Nueva Córdoba", href: "https://wa.me/5493516142090" },
    { name: "Contacto Valle Escondido", href: "https://wa.me/5493512151167" },
    { name: "Contacto Jesús María", href: "https://wa.me/5493525555050" },
  ],
};
---

<footer class="footer">
  <div class="container footer-content">
    
    <!-- Lado Izquierdo / Centro: Enlaces del Menú -->
    <div class="footer-navigation">
      
      <div class="footer-col">
        <h3>Navegación</h3>
        <ul>
          {footerLinks.general.map((link) => (
            <li><a href={link.href}>{link.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h3>Contacto y Locales</h3>
        <ul>
          {footerLinks.locales.map((link) => (
            <li><a href={link.href}>{link.name}</a></li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Lado Derecho: Descarga de Apps -->
    <div class="footer-apps">
      <h3>Descargá la App</h3>
      <div class="store-buttons">
        
        <!-- Botón App Store -->
        <a href="https://apps.apple.com/ar/app/frich/id6499274163" class="store-btn" aria-label="Descargar en App Store">
          <svg class="store-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.85c.66-.8 1.11-1.92.99-3.04-.96.04-2.13.64-2.81 1.44-.61.71-1.14 1.86-1 2.97 1.08.08 2.16-.57 2.82-1.37z"/>
          </svg>
          <div class="btn-text">
            <span class="subtext">Download on the</span>
            <span class="maintext">App Store</span>
          </div>
        </a>

        <!-- Botón Google Play -->
        <a href="https://play.google.com/store/apps/details?id=com.frichsfries.app&pcampaignid=web_share&pli=1" class="store-btn" aria-label="Consíguelo en Google Play">
          <svg class="store-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 20.5v-17c0-.55.33-.94.8-.73l12.42 8.78c.42.24.42.82 0 1.06L3.8 21.23c-.47.21-.8-.18-.8-.73zm13.79-8.5L14 9.17l-2.6 2.63 2.6 2.63 2.79-2.43zm2.14-1.37l2.27 1.32c.45.26.45.92 0 1.18l-2.27 1.32-2.3-2.3 2.3-2.52z"/>
          </svg>
          <div class="btn-text">
            <span class="subtext">GET IT ON</span>
            <span class="maintext">Google Play</span>
          </div>
        </a>

      </div>
    </div>

  </div>

  <div class="footer-bottom">
    <p>&copy; {new Date().getFullYear()} Frich. Todos los derechos reservados.</p>
  </div>
</footer>