---
import { Image } from 'astro:assets';
import myLogo from '../assets/logo.png';
import "../styles/Header.css";
const base = import.meta.env.BASE_URL;
// Enlaces visibles en la barra principal
const mainNavItems = [
{ name: "Inicio", href: `${base}/index` },
  { name: "Sucursales", href: `${base}/sucursales/` },
  { name: "Contacto", href: `${base}/contacto/` },
];

// Enlaces exclusivos del menú hamburguesa
const drawerItems = [
  { name: "Ayuda", href: `${base}/ayuda/` },
  { name: "Trabaja con nosotros", href: `${base}/trabaja/` },
  { name: "Delivery", href: `${base}/delivery/` },
  { name: "Nosotros", href: `${base}/nosotros/` },
];
---

<header class="header">
  <div class="container">
    <div class="left-group">
      <!-- Botón Hamburguesa -->
      <button class="hamburger-btn" id="menu-toggle" aria-label="Abrir menú">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>

      <!-- Logo -->
      <a href=`${base}/index` class="logo">
        <Image src={myLogo} alt="Logo Frich" class="logo-img" />
      </a>
    </div>

    <!-- Navegación Principal Superior -->
    <nav class="top-nav">
      <ul>
        {mainNavItems.map((item) => (
          <li>
            <a href={item.href}>{item.name}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<!-- Overlay para oscurecer el fondo al abrir el panel -->
<div class="menu-overlay" id="menu-overlay"></div>

<!-- Panel Lateral Desplegable (Drawer) -->
<aside class="side-drawer" id="side-drawer">
  <div class="drawer-content">
    <nav class="drawer-nav">
      <ul>
        {drawerItems.map((item) => (
          <li>
            <a href={item.href} class="drawer-link">{item.name}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Sección de Descarga de Apps -->
    <div class="app-download-section">
      <p class="download-title">
        Disfrutá de la<br /><strong>mejor experiencia</strong>
      </p>
      <div class="app-buttons">
        <a href="https://apps.apple.com/ar/app/frich/id6499274163" class="app-btn">
          <svg class="app-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.85c.66-.8 1.11-1.92.99-3.04-.96.04-2.13.64-2.81 1.44-.61.71-1.14 1.86-1 2.97 1.08.08 2.16-.57 2.82-1.37z"/>
          </svg>
          iOS
        </a>
        <a href="https://play.google.com/store/apps/details?id=com.frichsfries.app&pcampaignid=web_share&pli=1" class="app-btn">
          <svg class="app-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5516 0 .9997.4482.9997.9993s-.4481.9997-.9997.9997zm-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5516 0 .9997.4482.9997.9993s-.4481.9997-.9997.9997zm11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1522-.5676.416.416 0 00-.5676.1522l-2.0223 3.5028C15.6025 8.307 13.8855 7.917 12 7.917c-1.8855 0-3.6025.39-5.1367 1.0326L4.841 5.4468a.416.416 0 00-.5676-.1522.416.416 0 00-.1522.5676l1.9973 3.4592C2.6826 11.2323.3333 14.8622.3333 19.0833h23.3334c0-4.2211-2.3493-7.851-5.7887-9.7619z"/>
          </svg>
          Android
        </a>
      </div>
    </div>
  </div>
</aside>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const sideDrawer = document.getElementById('side-drawer');
  const menuOverlay = document.getElementById('menu-overlay');
  const drawerLinks = document.querySelectorAll('.drawer-link');

  function toggleMenu() {
    menuToggle?.classList.toggle('active');
    sideDrawer?.classList.toggle('open');
    menuOverlay?.classList.toggle('show');
    document.body.classList.toggle('no-scroll');
  }

  function closeMenu() {
    menuToggle?.classList.remove('active');
    sideDrawer?.classList.remove('open');
    menuOverlay?.classList.remove('show');
    document.body.classList.remove('no-scroll');
  }

  menuToggle?.addEventListener('click', toggleMenu);
  menuOverlay?.addEventListener('click', closeMenu);

  drawerLinks.forEach(link => {
    link.addEventListener('click', closeMenu);
  });
</script>
